{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "auth": {
      "mode": "none"
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "thinkingDefault": "low"
    },
    "entries": {
      "main": {
        "workspace": "/home/ubuntu/.openclaw-tps/workspace"
      },
      "speed": {
        "workspace": "/home/ubuntu/.openclaw-tps/workspace-speed"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cerebras": {
        "baseUrl": "https://api.cerebras.ai/v1",
        "api": "openai-completions",
        "apiKey": "${CEREBRAS_API_KEY}",
        "maxTokens": 8192,
        "timeoutSeconds": 180,
        "models": [
          {
            "id": "moonshotai-kimi-k3.1-pro-trial",
            "name": "Kimi K3.1 Pro (Cerebras)",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 131072,
            "maxTokens": 8192,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "compat": {
              "supportsTools": true,
              "supportsStrictMode": false,
              "supportsReasoningEffort": true,
              "supportedReasoningEfforts": ["low", "high", "max"],
              "maxTokensField": "max_tokens"
            }
          }
        ]
      }
    }
  },
  "tools": {
    "toolSearch": false
  },
  "mcp": {
    "servers": {
      "shopify-catalog": {
        "url": "https://catalog.shopify.com/api/ucp/mcp",
        "transport": "streamable-http",
        "toolFilter": {
          "include": ["search_catalog", "lookup_catalog", "get_product"]
        }
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  }
}
